# === Secrets (never commit) ===
.env
.env.local
# SonarQube analysis/user token minted on first login (Phase 4 P3). Persisted
# locally so scripts/sonarqube_client.py can read it; NEVER committed.
.sonar-token

# === Riptide / HumanLayer artifacts (cloud-synced symlink target) ===
.humanlayer/tasks/

# === Local databases (mem0 pgvector, Hermes state/kanban, SQLite) ===
*.db
*.db-shm
*.db-wal

# === Hermes local home artifacts ===
.hermes/

# === Generated analysis & run artifacts ===
graphify-out/
recordings/
workspaces/

# === Report video artifacts stay LOCAL (too large for git; linked from README) ===
# The NotebookLM video overviews (50-60MB each) live only on disk + are linked from
# README via their NotebookLM share URL. The PDF/PPTX/PNG report artifacts in
# docs/report/ ARE tracked (they're small enough and render inline).
docs/report/*.mp4

# === Recorder persistent Chromium profile (GLO-14 P3 authenticated live-Linear ending) ===
# A bind-mounted, PERSISTENT, AUTHENTICATED Chromium profile lets the OPTIONAL
# TICKET_LIVE_URL=1 ending render the real logged-in Linear ticket. It holds a live
# session (cookies/tokens) — NEVER commit it (AGENTS.md rule 3/8). The default
# file:// snapshot ending needs no profile, so a clean clone has nothing here.
recorder-profile/

# === Corpus: converted copyrighted textbooks stay LOCAL ===
# Conversion scripts are tracked; their Markdown output is not (review decision).
corpus/

# === RAG vector index (rebuilt from corpus; never committed) ===
# Docker uses the `rag-index` named volume; a local `uv run rag/server.py` falls
# back to rag/.lancedb. Both are generated artifacts.
.lancedb/
rag/.lancedb/

# === Python ===
__pycache__/
*.pyc
.venv/
venv/

# === macOS ===
.DS_Store

# === Local scratch / exploratory notes (not part of the public repo) ===
geminiExploratoryThread*.docx
