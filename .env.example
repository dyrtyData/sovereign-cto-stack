# === Sovereign CTO Stack — environment template ===
# Copy to .env and fill in real values. .env is gitignored; NEVER commit it.

# --- Nous Portal (Hermes inference) ---
# Static API key from https://portal.nousresearch.com/ (Settings -> API Keys).
# Note: `hermes setup --portal` uses a separate OAuth device-code flow (~/.hermes/auth.json);
# this key is the OpenAI-compatible inference credential.
NOUS_PORTAL_API_KEY=sk-nous-xxxxxxxxxxxxxxxxxxxxxxxx

# --- mem0 self-hosted pgvector (docker-compose mem0-postgres) ---
# Host port the mem0-postgres container publishes to. Default 5433 to avoid colliding
# with a host-native Postgres on 5432. The mem0 SDK / roundtrip read MEM0_PG_PORT.
MEM0_PG_HOST_PORT=5433
MEM0_PG_PORT=5433

# --- CTO knowledge RAG sidecar (docker-compose rag-sidecar, Phase 2) ---
# Host port the rag-sidecar publishes the MCP/HTTP server on. Hermes binds it at
# http://localhost:8080/mcp (hermes/config.yaml mcp_servers.cto_knowledge).
RAG_HOST_PORT=8080

# --- mem0 Platform (cloud fallback for self-hosted pgvector memory) ---
# Optional. Key from https://app.mem0.ai/ (Platform mode fallback per design Q6).
# Leave blank to use only the self-hosted pgvector OSS mode.
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (Hermes gateway messaging) ---
# Bot token from @BotFather in Telegram: /newbot -> choose name + username ending in "bot".
TELEGRAM_BOT_TOKEN=123456789:ABCdef-GhiJklmnoPQRstuvwxyz

# Your numeric Telegram user id from @userinfobot (comma-separate to allow more users).
TELEGRAM_ALLOWED_USERS=123456789

# Optional channel id for cron delivery (from the channel; leave blank if unused).
TELEGRAM_HOME_CHANNEL=
