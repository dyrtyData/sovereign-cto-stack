# === Sovereign CTO Stack — environment template ===
# Copy to .env and fill in real values. .env is gitignored; NEVER commit it.

# --- Nous Portal (Hermes inference) ---
# Static API key from https://portal.nousresearch.com/ (Settings -> API Keys).
# Note: `hermes setup --portal` uses a separate OAuth device-code flow (~/.hermes/auth.json);
# this key is the OpenAI-compatible inference credential.
NOUS_PORTAL_API_KEY=sk-nous-xxxxxxxxxxxxxxxxxxxxxxxx

# --- mem0 self-hosted pgvector (docker-compose mem0-postgres) ---
# Host port the mem0-postgres container publishes to. Default 5433 to avoid colliding
# with a host-native Postgres on 5432. The mem0 SDK / roundtrip read MEM0_PG_PORT.
MEM0_PG_HOST_PORT=5433
MEM0_PG_PORT=5433

# --- CTO knowledge RAG sidecar (docker-compose rag-sidecar, Phase 2) ---
# Host port the rag-sidecar publishes the MCP/HTTP server on. Hermes binds it at
# http://localhost:8080/mcp (hermes/config.yaml mcp_servers.cto_knowledge).
RAG_HOST_PORT=8080

# --- mem0 Platform (cloud fallback for self-hosted pgvector memory) ---
# Optional. Key from https://app.mem0.ai/ (Platform mode fallback per design Q6).
# Leave blank to use only the self-hosted pgvector OSS mode.
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (AARRR Revenue/Retention grounding, Phase 3) ---
# Stripe TEST-mode secret key (sk_test_…) from https://dashboard.stripe.com/test/apikeys.
# REQUIRED for the real Stripe-grounded AARRR Revenue & Retention brief: scripts/
# stripe_client.py reads LIVE test-mode subscriptions to compute real MRR/churn/cohorts
# into recordings/stripe_metrics.json — it does NOT fabricate numbers. A fresh sandbox
# is empty, so seed it once first:  python3 scripts/stripe_seed.py
# SAFETY: only TEST keys are accepted; a live key (sk_live_…) is REFUSED by the client.
# Not gated by preflight.sh (the stack still runs without it; only the Stripe grounding
# is unavailable) — mirrors the MEM0_API_KEY optional pattern.
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- SonarQube (code-quality DETECT signal, Phase 4 / P3) ---
# SonarQube Community runs in Docker (compose profile "sonar"):
#   docker compose --profile sonar up -d sonarqube     # http://localhost:9000
# On first login (admin/admin) change the password and mint a token, then persist
# it to ./.sonar-token (gitignored — NEVER committed). scripts/sonarqube_client.py
# reads $SONAR_TOKEN, else ./.sonar-token, else ~/.hermes/sonar-token, and pulls
# REAL issues/measures (GET /api/issues/search + /api/measures/component) into
# graphify-out/sonar-issues.json. NO graceful degradation: if SonarQube is
# unreachable or unscanned, the client/gate FAIL loudly (never fabricate issues).
# Scan the gitignored demo clone with the official scanner image:
#   docker run --rm -e SONAR_HOST_URL=http://host.docker.internal:9000 \
#     -e SONAR_TOKEN=$(cat .sonar-token) \
#     -e SONAR_SCANNER_OPTS="-Dsonar.projectKey=online-boutique -Dsonar.sources=src -Dsonar.exclusions=**/*.java,**/genproto/**,**/node_modules/**,**/vendor/**" \
#     -v "$PWD/workspaces/microservices-demo:/usr/src" sonarsource/sonar-scanner-cli
# SONAR_TOKEN is optional/ungated (preflight.sh unchanged); only the SonarQube
# fusion is unavailable without it.
SONAR_TOKEN=squ_REPLACE_WITH_YOUR_SONARQUBE_TOKEN

# --- Codegen (remediation back-end, Phase 4 / P3) ---
# Codegen's agentic multi-file SWE back-end, registered under mcp_servers in
# hermes/config.yaml. The [Brownfield] ticket ROUTES to Codegen (named back-end);
# the live agent call is opt-in (the free-tier runs are reserved for an optional
# demo). Moderne/OpenRewrite is the recipe-amenable alternative (no free tier —
# "evaluate Moderne (paid)" rolled into GLO-14). Optional/ungated.
CODEGEN_API_KEY=cg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (Hermes gateway messaging) ---
# Bot token from @BotFather in Telegram: /newbot -> choose name + username ending in "bot".
TELEGRAM_BOT_TOKEN=123456789:ABCdef-GhiJklmnoPQRstuvwxyz

# Your numeric Telegram user id from @userinfobot (comma-separate to allow more users).
TELEGRAM_ALLOWED_USERS=123456789

# Optional channel id for cron delivery (from the channel; leave blank if unused).
TELEGRAM_HOME_CHANNEL=

# --- Deny-by-default egress (NVIDIA OpenShell sandbox, Phase 2) ---
# No env key needed. Egress is enforced out-of-process by a real OpenShell sandbox
# (verified against 0.0.71), NOT a compose service: workloads are confined with
#   openshell sandbox create --no-keep --policy egress/policy.yaml --from egress/ -- <cmd>
# which tunnels ONLY the allow-listed host:port pairs in egress/policy.yaml and
# refuses everything else (deny-by-default). Requires `openshell` with a Connected
# gateway (`openshell status`) and a running Docker daemon. Verify with
# `python scripts/assert_egress_policy.py` (negative + positive CONNECT test).
