# === Hermes home .env template (~/.hermes/.env) ===
#
# Hermes reads secrets from $HERMES_HOME/.env (default ~/.hermes/.env), NOT from the
# repo .env. This template documents the keys the Hermes gateway/memory need. Copy the
# values from the repo .env into ~/.hermes/.env (or run the documented setup commands,
# which write them). NEVER commit a filled-in copy — this file holds placeholders only.

# --- Telegram gateway (one bot token per profile) ---
# Bot token from @BotFather; numeric id(s) from @userinfobot; optional channel id for
# cron delivery. These mirror TELEGRAM_* in the repo .env.
TELEGRAM_BOT_TOKEN=123456789:ABCdef-GhiJklmnoPQRstuvwxyz
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_HOME_CHANNEL=

# --- mem0 Platform fallback (optional) ---
# Only needed if hermes/mem0.json mode is switched from "oss" to "platform".
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Nous Portal direct inference key (optional) ---
# `hermes portal login` uses OAuth (~/.hermes/auth.json) and does not require this.
# Present only if you prefer the static OpenAI-compatible key path.
NOUS_PORTAL_API_KEY=sk-nous-xxxxxxxxxxxxxxxxxxxxxxxx
