#!/usr/bin/env bash
# Tracked pre-commit hook — public-repo secret gate (AGENTS.md rule 8).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Fails the commit if gitleaks finds a secret in the staged changes. Fails CLOSED
# if gitleaks is not installed — the whole point is that a public repo never leaks
# a credential, so "can't scan" must block, not silently pass.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found — install it before committing (brew install gitleaks)." >&2
  echo "            (This repo is public; the secret gate fails closed.)" >&2
  exit 1
fi

if ! gitleaks protect --staged --no-banner; then
  echo "pre-commit: gitleaks found a potential secret in the staged changes — commit blocked." >&2
  echo "            Remove the secret (use .env, which is gitignored) and re-stage." >&2
  exit 1
fi

echo "pre-commit: gitleaks clean."

# --- AGENTS.md rule 6 — living-docs reminder (non-blocking) -------------------
# If this commit changes code/config but stages no README.md or docs/ update, warn
# (does NOT block). Living docs (README.md, docs/setup-guide.md,
# docs/system-design-tradeoffs.md, docs/cto-functions.md) must stay current per slice.
# Override intentionally with DOCS_OK=1 (e.g. a pure refactor that truly needs no doc).
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -qE '^(scripts/|hermes/|egress/|docker-compose\.yml)'; then
  if ! printf '%s\n' "$staged" | grep -qE '^(README\.md|docs/)'; then
    if [ "${DOCS_OK:-0}" != "1" ]; then
      echo "pre-commit: WARNING — code/config changed but no README.md or docs/ update is staged" >&2
      echo "            (AGENTS.md rule 6: living docs every phase/commit). Update the docs for" >&2
      echo "            this slice, or set DOCS_OK=1 to bypass intentionally." >&2
    fi
  fi
fi
